{
    "name": "kernel243/artisan",
    "description": "Commandes artisan de génération de code (repository, service, resource, controller, CRUD, vues, langues) pour Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "artisan",
        "commands",
        "generator",
        "repository",
        "service",
        "controller",
        "resource",
        "stubs"
    ],
    "authors": [
        {
            "name": "merdi elongo",
            "email": "merdielongo9@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "spatie/laravel-data": "^4.23"
    },
    "suggest": {
        "spatie/laravel-data": "Required by the DTOs generated by kernel:data and used by kernel:action"
    },
    "autoload": {
        "psr-4": {
            "Kernel243\\Artisan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kernel243\\Artisan\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kernel243\\Artisan\\CommandServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "lint:check": "pint --test",
        "ci:check": [
            "@lint:check",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
