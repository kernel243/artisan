<?php

namespace DummyNamespace;

use DummyBaseControllerClass;
use DummyModelClass;
use DummyRepositoryClass;
use DummyResourceClass;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Http\Resources\Json\AnonymousResourceCollection;

class DummyClass extends DummyBaseController
{
    public function __construct(protected DummyRepository $DummyRepositoryProperty)
    {
    }

    /**
     * Display a listing of the resource.
     */
    public function index(): AnonymousResourceCollection
    {
        return DummyResource::collection($this->DummyRepositoryProperty->getPaginate());
    }

    /**
     * Store a newly created resource in storage.
     */
    public function store(Request $request): DummyResource
    {
        return new DummyResource($this->DummyRepositoryProperty->store($request->all()));
    }

    /**
     * Display the specified resource.
     */
    public function show(DummyModel $DummyModelProperty): DummyResource
    {
        return new DummyResource($DummyModelProperty);
    }

    /**
     * Update the specified resource in storage.
     */
    public function update(Request $request, DummyModel $DummyModelProperty): DummyResource
    {
        return new DummyResource($this->DummyRepositoryProperty->update(
            $request->except(['_token', '_method']),
            $DummyModelProperty->getKey()
        ));
    }

    /**
     * Remove the specified resource from storage.
     */
    public function destroy(DummyModel $DummyModelProperty): JsonResponse
    {
        $this->DummyRepositoryProperty->delete($DummyModelProperty->getKey());

        return response()->json(['success' => true]);
    }
}
