<?php

namespace DummyNamespace;

/**
 * Expose les cases d'un enum aux formulaires : values() pour la validation
 * (Rule::in / Rule::enum), options() pour alimenter les selects Vue.
 *
 * L'enum doit être string-backed et définir label().
 */
trait HasOptions
{
    /**
     * @return list<string>
     */
    public static function values(): array
    {
        return array_column(self::cases(), 'value');
    }

    /**
     * @return list<array{value: string, label: string}>
     */
    public static function options(): array
    {
        return array_map(
            fn (self $case): array => ['value' => $case->value, 'label' => $case->label()],
            self::cases(),
        );
    }
}
