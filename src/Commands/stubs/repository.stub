<?php

namespace DummyNamespace;

use DummyModelClass;
use Illuminate\Contracts\Pagination\LengthAwarePaginator;
use Illuminate\Database\Eloquent\Collection;

class DummyClass
{
    public function __construct(protected DummyModel $DummyProperty = new DummyModel())
    {
    }

    /**
     * Retrieve a DummyModel by its primary key.
     */
    public function getById(mixed $id): DummyModel
    {
        return $this->DummyProperty->newQuery()->findOrFail($id);
    }

    /**
     * Retrieve all DummyModel records.
     *
     * @return Collection<int, DummyModel>
     */
    public function getAll(): Collection
    {
        return $this->DummyProperty->newQuery()->get();
    }

    /**
     * Get a paginated list of DummyModel records.
     */
    public function getPaginate(int $perPage = 15): LengthAwarePaginator
    {
        return $this->DummyProperty->newQuery()->paginate($perPage);
    }

    /**
     * Check if a DummyModel exists for the given field value.
     */
    public function exists(string $field, mixed $value, string $operator = '='): bool
    {
        return $this->DummyProperty->newQuery()->where($field, $operator, $value)->exists();
    }

    /**
     * Retrieve the first DummyModel matching the given field value.
     */
    public function get(string $field, mixed $value, string $operator = '='): DummyModel
    {
        return $this->DummyProperty->newQuery()->where($field, $operator, $value)->firstOrFail();
    }

    /**
     * Get a paginated list of DummyModel records matching the constraints.
     *
     * @param  array<string, mixed>  $constraints
     */
    public function getListByPagination(array $constraints, int $perPage = 30): LengthAwarePaginator
    {
        return $this->DummyProperty->newQuery()->where($constraints)->paginate($perPage);
    }

    /**
     * Get the DummyModel records matching the constraints.
     *
     * @param  array<string, mixed>  $constraints
     * @return Collection<int, DummyModel>
     */
    public function getList(array $constraints): Collection
    {
        return $this->DummyProperty->newQuery()->where($constraints)->get();
    }

    /**
     * Store a new DummyModel.
     *
     * @param  array<string, mixed>  $inputs
     */
    public function store(array $inputs): DummyModel
    {
        return $this->DummyProperty->newQuery()->create($inputs);
    }

    /**
     * Update a DummyModel.
     *
     * @param  array<string, mixed>  $inputs
     */
    public function update(array $inputs, mixed $id): DummyModel
    {
        $instance = $this->getById($id);
        $instance->update($inputs);

        return $instance->refresh();
    }

    /**
     * Delete a DummyModel.
     */
    public function delete(mixed $id): void
    {
        $this->getById($id)->delete();
    }

    /**
     * Permanently delete a DummyModel (models using SoftDeletes).
     */
    public function forceDelete(mixed $id): void
    {
        $this->DummyProperty->newQuery()
            ->when(method_exists($this->DummyProperty, 'trashed'), fn ($query) => $query->withTrashed())
            ->findOrFail($id)
            ->forceDelete();
    }
}
